{
  "name": "pw-automation",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright + TypeScript UI, API and end-to-end test automation framework for the AutomationExercise practice store.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:smoke": "playwright test --grep @smoke --project=api --project=chromium",
    "test:headed": "playwright test --project=chromium --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "report:allure": "allure generate allure-results --output allure-report && allure open allure-report",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "allure": "^3.33.0",
    "allure-playwright": "^3.15.0",
    "eslint": "^10.15.0",
    "eslint-plugin-playwright": "^2.12.2",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "zod": "^4.6.7"
  }
}
